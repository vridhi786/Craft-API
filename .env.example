# ---------- REQUIRED ----------
NODE_ENV=development
PORT=5000
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SECRET server key ("service_role"). Never put it in the website or commit it. The anon key will NOT work: every table has RLS and no policies.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Comma-separated list of exact website origins allowed by CORS (no trailing slash). https:// required in production
FRONTEND_ORIGIN=http://localhost:5173
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ---------- STRONGLY RECOMMENDED ----------
# Business WhatsApp number, international format, digits only (default; editable later in Admin > Settings)
WHATSAPP_BUSINESS_NUMBER=919574546023
# Public site URL (used by the sitemap generator)
SITE_URL=https://www.example.com

# ---------- IMAGE STORAGE (Cloudinary). Uploads return 503 until these are set ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- OPTIONAL ----------
JWT_EXPIRES_IN=8h
# "none" when website and API are on different sites (needs HTTPS; default in production), "lax" for the same site / local dev
COOKIE_SAMESITE=
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
ORDER_RATE_LIMIT_MAX=20
# Reverse proxies in front of the API (Render = 1; default 1 in production)
TRUST_PROXY=1
# HOST defaults to 0.0.0.0 (required on Render). PORT is injected by Render.
HOST=0.0.0.0

# ---------- ONE-TIME ADMIN PROVISIONING (used only by `npm run create-admin`; remove afterwards) ----------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
